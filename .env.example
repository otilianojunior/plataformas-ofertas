# PostgreSQL no Docker (make db). Usados pelo docker-compose.yml.
POSTGRES_USUARIO=ofertas_app
POSTGRES_SENHA=TROQUE_ESTA_SENHA
POSTGRES_BANCO=plataformas_ofertas
POSTGRES_PORTA=5434

# Conexão da API com o banco: use os mesmos valores de cima.
DATABASE_URL=postgresql+psycopg://ofertas_app:TROQUE_ESTA_SENHA@localhost:5434/plataformas_ofertas

# Chave Fernet para criptografia de credenciais
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_FERNET

# Chrome usado para gerar links afiliados do Mercado Livre (todos opcionais).
# Perfil dedicado do projeto, separado do seu Chrome pessoal. Caminho relativo
# é resolvido a partir da raiz do repositório. Faça o login com: make chrome-login
MERCADO_LIVRE_CHROME_PROFILE_DIR=data/chrome_profile
# Vazio: detecta google-chrome, google-chrome-stable, chromium ou chromium-browser
MERCADO_LIVRE_CHROME_PATH=
# Porta de depuração local usada pela API para controlar o Chrome
MERCADO_LIVRE_CHROME_CDP_URL=http://127.0.0.1:9222

# WhatsApp Web (NÃO oficial: risco de restrição/banimento do número).
# Perfil próprio do Chrome, separado do Mercado Livre. Login: make whatsapp-login
WHATSAPP_CHROME_PROFILE_DIR=data/whatsapp_profile
WHATSAPP_CHROME_CDP_URL=http://127.0.0.1:9223
# Intervalo mínimo entre QUAISQUER duas mensagens (todos os grupos), mínimo 60
WHATSAPP_INTERVALO_MINIMO_SEGUNDOS=120
# Máximo de mensagens por dia somando todos os grupos
WHATSAPP_LIMITE_DIARIO=30

# Nível dos logs da API (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
