# Conexão com o PostgreSQL
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5433/plataformas_ofertas

# Chave Fernet para criptografia de credenciais
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_FERNET

# Chrome usado para gerar links afiliados do Mercado Livre (todos opcionais).
# Perfil dedicado do projeto, separado do seu Chrome pessoal. Caminho relativo
# é resolvido a partir da raiz do repositório. Faça o login com: make chrome-login
MERCADO_LIVRE_CHROME_PROFILE_DIR=data/chrome_profile
# Vazio: detecta google-chrome, google-chrome-stable, chromium ou chromium-browser
MERCADO_LIVRE_CHROME_PATH=
# Porta de depuração local usada pela API para controlar o Chrome
MERCADO_LIVRE_CHROME_CDP_URL=http://127.0.0.1:9222
